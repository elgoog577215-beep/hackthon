# 复制为 .env 后，生产环境二选一配置官方 DeepSeek 或 ModelScope；
# 不要在此文件写真实密钥。本机 Codex 通道只用于研发验收，见下方说明。

# 官方 DeepSeek（默认）
AI_API_KEY=your_api_key_here
AI_API_BASE=https://api.deepseek.com
AI_THINKING_ENABLED=true
AI_MIN_REQUEST_INTERVAL_SECONDS=1.5

# Optional last-resort provider. It is never used while the primary AI pool
# succeeds; keep the real key only in the server environment or secret store.
# MODELSCOPE_API_KEY=your_modelscope_fallback_key
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1/
MODELSCOPE_MODEL=Qwen/Qwen3.5-35B-A3B

# ---------------------------------------------------------------------------
# 可选：本机 Codex 研发验收通道（默认关闭，禁止作为生产提供方）
# ---------------------------------------------------------------------------
# 该通道复用当前电脑的 Codex 登录态，通过只读、临时目录的子进程执行真实课程
# 生成链。它不是稳定 HTTP API，不具备服务账号、用量隔离或生产 SLA。
# 启用时可以不设 AI_API_KEY，但必须先确认本机 codex 可执行文件已安装且已登录。
# AI_CODEX_LOCAL_ENABLED=true
# CODEX_LOCAL_BINARY=/absolute/path/to/codex
# CODEX_LOCAL_MODEL=
# CODEX_LOCAL_TIMEOUT_SECONDS=240
# CODEX_LOCAL_MAX_ATTEMPTS=1
# CODEX_LOCAL_FAST_REASONING_EFFORT=low
# CODEX_LOCAL_SMART_REASONING_EFFORT=medium
# 进程级调用存在启动成本，验收时建议从并发 1–2 开始。
# AI_PROVIDER_INITIAL_CONCURRENCY=1
# AI_PROVIDER_MAX_CONCURRENCY=2

QUESTION_BANK_REBUILD_MAX_WORKERS=1
ASSESSMENT_SLOT_CONCURRENCY=1
ASSESSMENT_GENERATION_BATCH_SIZE=2
ASSESSMENT_SEMANTIC_BATCH_WAIT_SECONDS=12
# 同一学习目标内的跨题型语义判重阈值，代码强制限制在 0.50-0.95。
ASSESSMENT_DIVERSITY_THRESHOLD=0.72
# 可按学科覆盖全局值：STEM、PROGRAMMING、LANGUAGE、HUMANITIES、GENERAL。
# ASSESSMENT_DIVERSITY_THRESHOLD_STEM=0.72
# ASSESSMENT_DIVERSITY_THRESHOLD_PROGRAMMING=0.72
AI_SLIDE_PLANNER_ENABLED=true
# 新版课程具备正式教学计划时启用课程逻辑驱动的 slide_deck_v5；
# 关闭 V5 时回退到 V4；关闭故事引擎时才回退到兼容的 V3。
SLIDE_DECK_V5_ENABLED=true
SLIDE_STORY_ENGINE_V2_ENABLED=true
SLIDE_DECK_V5_ENABLED=true

# 课程知识规划共享并发预算：默认 4，代码会限制在 1-8 之间。
# 提供方出现 429 或延迟抖动时优先下调，不要靠降低模型质量换速度。
COURSE_GENERATION_PLANNING_CONCURRENCY=4

# 首次课程生成不限制课程总章节数。以下配置只限制单次请求或一次可恢复工作窗口；
# 大课会继续拆分、并行、保存检查点，而不是拒绝用户或发送超大载荷。
COURSE_GENERATION_MAX_INPUT_CHARS=20000
COURSE_GENERATION_MAX_INPUT_TOKENS=7000
COURSE_OUTLINE_MAX_OUTPUT_TOKENS=4096
COURSE_CONTENT_MAX_OUTPUT_TOKENS=8192
COURSE_GENERATION_PROVIDER_MAX_ATTEMPTS=2
COURSE_GENERATION_INACTIVITY_TIMEOUT_SECONDS=90
# 正文持续有流式输出就继续；只有连续无进展才中断当前小节。
COURSE_CONTENT_INACTIVITY_TIMEOUT_SECONDS=90
COURSE_CONTENT_CONCURRENCY=4
COURSE_CONTENT_MAX_RETRIES=1

# 所有课程都采用“章节骨架 → 按章并行小节批次 → 本地汇编”的完整目录链路。
# 每批最多 6 节只是单次调用颗粒度，不是课程总量上限。章节之间并行，同一章的多个
# 批次按顺序生成；持续有输出就继续，只在连续无输出时停止当前最小单元。
COURSE_OUTLINE_BATCH_MAX_SECTIONS=6
COURSE_OUTLINE_INACTIVITY_TIMEOUT_SECONDS=90

# 全课教案采用“有界骨架分片 → 逐节详细教案 → 本地汇编”。auto 只对 1 节课程使用紧凑单次调用；
# 大课骨架每片最多 2 节，详细教案一次只生成 1 节，避免两节完整教案在一次输出中逼近或超过 8k token。
# 本地工作并发最多 4，真实模型容量由下方共享调度器动态控制。
# 本地语义兜底只保存可恢复预览，不会继续生成正文。
COURSE_TEACHING_PLAN_SKELETON_MAX_SECTIONS=2
COURSE_TEACHING_PLAN_BATCH_MAX_SECTIONS=1
COURSE_TEACHING_PLAN_BATCH_MAX_KNOWLEDGE=15
COURSE_TEACHING_PLAN_MAX_INPUT_TOKENS=7000
COURSE_TEACHING_PLAN_MAX_OUTPUT_TOKENS=8000
COURSE_TEACHING_PLAN_CONCURRENCY=4
COURSE_TEACHING_PLAN_INACTIVITY_TIMEOUT_SECONDS=90
AI_PROVIDER_INITIAL_CONCURRENCY=2
AI_PROVIDER_MAX_CONCURRENCY=4
AI_PROVIDER_SUCCESSES_TO_GROW=3
AI_PROVIDER_START_INTERVAL_SECONDS=0.5
AI_VISUAL_PLAN_CONCURRENCY=2
AI_VISUAL_PLAN_MAX_PAGES=12

# 本地默认只写文件，不让运行数据自动产生 Git 提交。
# 只有明确需要由部署环境托管数据版本时才改为 true。
GIT_AUTO_SYNC_ENABLED=false

# 官方 DeepSeek 会自动默认 deepseek-v4-pro / deepseek-v4-flash。
# 如需固定模型，可取消以下两行注释：
# AI_MODEL=deepseek-v4-pro
# AI_MODEL_FAST=deepseek-v4-flash

# 或者改为 ModelScope：
# AI_API_KEY=your_modelscope_api_key_here
# AI_API_BASE=https://api-inference.modelscope.cn/v1
# AI_MODEL_CANDIDATES=Qwen/Qwen3.5-122B-A10B,Qwen/Qwen3.5-397B-A17B,deepseek-ai/DeepSeek-V4-Flash
# AI_MODEL_FAST_CANDIDATES=deepseek-ai/DeepSeek-V4-Flash,Qwen/Qwen3.5-122B-A10B,Qwen/Qwen3.5-397B-A17B
# 可选：为出题、独立求解和质量评审配置不同模型池。
# 未配置时，求解器会从通用候选池的第二个模型开始，降低同模型自审。
# AI_ASSESSMENT_GENERATOR_MODELS=Qwen/Qwen3.5-122B-A10B,Qwen/Qwen3.5-397B-A17B,deepseek-ai/DeepSeek-V4-Flash
# AI_ASSESSMENT_SOLVER_MODELS=Qwen/Qwen3.5-397B-A17B,Qwen/Qwen3.5-122B-A10B,deepseek-ai/DeepSeek-V4-Flash
# AI_ASSESSMENT_REVIEWER_MODELS=deepseek-ai/DeepSeek-V4-Flash,Qwen/Qwen3.5-397B-A17B,Qwen/Qwen3.5-122B-A10B

# ---------------------------------------------------------------------------
# 或者改为自部署千问（启智的 vLLM 类 OpenAI 兼容服务，生产在阿里云同机部署）
# ---------------------------------------------------------------------------
# 接入前先跑：
#   backend/.venv/bin/python scripts/qwen_endpoint_smoke.py \
#       --base-url $QWEN_BASE_URL --model <模型ID> --api-key EMPTY
# 该脚本会验证 /v1/models、短补全、长 JSON 截断和 enable_thinking 兼容性。
#
# AI_API_BASE=http://<自部署地址>:8000/v1
# 无鉴权端点也必须填占位符，不能留空：ai_base.py:187-198 在 AI_API_KEY
# 为空字符串时会把 client 置为 None 并禁用全部 AI 能力（实测确认）。
# AI_API_KEY=EMPTY
# 模型 ID 必须与端点 /v1/models 返回的完全一致。
# AI_MODEL=Qwen/Qwen3-32B
# AI_MODEL_FAST=Qwen/Qwen3-8B
#
# 并发：上游无并发能力，从 2 起步。两个变量都要设，且注意
# max_limit = max(INITIAL, MAX)——只把 MAX 调成 1 而 INITIAL 仍是 2 时，
# 实际上限仍是 2（实测确认）。要真正降到 1，两个都要写 1。
# AI_PROVIDER_INITIAL_CONCURRENCY=2
# AI_PROVIDER_MAX_CONCURRENCY=2
# 同机部署无需额外限速；若观察到端点排队再调大此值。
# AI_MIN_REQUEST_INTERVAL_SECONDS=0
#
# thinking：先用 smoke 脚本确认端点接受哪种写法。ai_base 目前发送扁平的
# {"enable_thinking": bool}，而 vLLM 常要求嵌套在 chat_template_kwargs 下。
# 若脚本报告只接受嵌套写法，需先改 ai_base._thinking_extra_body 再上线；
# 若两种都不支持，这里设 false，避免每次调用都带无效字段。
# AI_THINKING_ENABLED=false
#
# 输出上限：截断的长 JSON 会在下游解析失败，看起来像内容质量问题
# （见 ai_base.py:157-164 的记录）。以 smoke 脚本的长 JSON 结果为准。
# AI_MAX_TOKENS=8192
#
# 注意：**候选链不能跨端点做 provider 级 fallback。**
# AI_MODEL_CANDIDATES 只是同一个 AI_API_BASE 下的模型 ID 列表——
# 全后端只有一个 AsyncOpenAI 客户端（ai_base.py:190），由单一
# AI_API_BASE 构造，_models_for 只返回模型名。所以把外部 API 写进
# 候选链不会在自部署端点故障时切过去，只会用外部端点不存在的模型名去请求它。
# 想要"自部署优先、外部兜底"，需要先支持按候选项携带 base_url/key
# （属于 ai_base 改造，尚未实现）。当前可行的降级手段是运维层面改
# AI_API_BASE + AI_API_KEY 后重启。

# 联网研究默认关闭。生产环境先部署本机 SearXNG，再按 off → allowlist → on 灰度。
WEB_RETRIEVAL_PROVIDER=searxng
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_REQUEST_TIMEOUT_SECONDS=6
WEB_RETRIEVAL_V2_MODE=off
# allowlist 模式下填写逗号分隔的教师用户 ID；不要填写学生画像或个人信息。
# WEB_RETRIEVAL_V2_USER_IDS=teacher_user_id
# Exa 仅保留兼容适配器；只有显式设置 WEB_RETRIEVAL_PROVIDER=exa 时才会调用。
# EXA_API_KEY=your_legacy_exa_api_key_here

# Optional: an OpenAI Images-compatible service for original PPT illustrations.
# Unconfigured, timed-out, or invalid responses fall back to editable diagrams.
# SLIDE_IMAGE_API_BASE=https://api.openai.com/v1
# SLIDE_IMAGE_API_KEY=replace_with_slide_image_api_key
# SLIDE_IMAGE_MODEL=gpt-image-1
# SLIDE_GENERATED_ILLUSTRATIONS_ENABLED=false

# Optional: retrieve public-domain/CC0/CC BY images for PPT V5.
# The server license allow-list is fixed and cannot be widened by clients.
# SLIDE_WEB_IMAGE_RETRIEVAL_ENABLED=false

# Production images install LibreOffice, Poppler and Noto CJK, then OCR every exported page.
# Keep enabled in production; local development can omit it when those binaries are unavailable.
# SLIDE_LIBREOFFICE_AUDIT_ENABLED=true

# 正式代码题必须连接独立 Runner；未配置时代码实现题不会自动投放。
FORMAL_RUNNER_URL=http://formal-runner:8091
FORMAL_RUNNER_TOKEN=replace_with_a_long_random_internal_token
# Linux 主机上 Docker socket 所属组 ID，可用 `stat -c %g /var/run/docker.sock` 查看。
DOCKER_GID=999
