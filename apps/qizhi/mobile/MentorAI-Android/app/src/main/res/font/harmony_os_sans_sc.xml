<?xml version="1.0" encoding="utf-8"?>
<!--
    Font family that groups the four bundled HarmonyOS Sans SC weights. With this XML the
    Android text stack (and Markwon's TextView inside it) can pick the right variant when a
    span asks for a different weight, instead of synthesising faux-bold.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/harmony_os_sans_sc_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/harmony_os_sans_sc_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/harmony_os_sans_sc_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
    <font
        android:font="@font/harmony_os_sans_sc_black"
        android:fontStyle="normal"
        android:fontWeight="900" />
</font-family>
