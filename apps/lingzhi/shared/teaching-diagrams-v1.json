{
  "schema_version": "teaching_diagram_v1",
  "fence": "lingzhi-diagram",
  "upstream": "https://github.com/cathrynlavery/diagram-design/tree/7a2e22170ee838e859d8142ba825d83f8b6375e6",
  "types": [
    {"id":"architecture","zh":"系统架构","en":"Architecture","family":"graph","use":"系统组件与连接","data":"nodes,edges"},
    {"id":"architecture_delta","zh":"架构变化","en":"Architecture delta","family":"delta","use":"同一系统前后结构变化","data":"before:{nodes,edges},after:{nodes,edges}"},
    {"id":"it_current_state","zh":"IT 现状","en":"IT current-state","family":"grouped","use":"部门或阶段中的现有系统","data":"groups,nodes,edges"},
    {"id":"flowchart","zh":"分支流程","en":"Flowchart","family":"flow","use":"有判断条件和明确出口的流程","data":"nodes(kind:decision 可选),edges(label:条件)"},
    {"id":"sequence","zh":"时序图","en":"Sequence","family":"sequence","use":"参与者之间按顺序发送消息","data":"nodes,edges(按消息顺序，kind:return 可选)"},
    {"id":"state_machine","zh":"状态转换","en":"State machine","family":"graph","use":"状态、触发与转换","data":"nodes,edges(label:触发条件)"},
    {"id":"er_model","zh":"实体关系","en":"ER / data model","family":"entity","use":"实体、字段和关系基数","data":"nodes(detail:字段),edges(label:基数)"},
    {"id":"timeline","zh":"时间轴","en":"Timeline","family":"timeline","use":"真实时间与事件间隔","data":"items(label,value:时间数值),unit"},
    {"id":"swimlane","zh":"泳道流程","en":"Swimlane","family":"swimlane","use":"不同职责间交接的过程","data":"groups,nodes(group:组ID),edges"},
    {"id":"quadrant","zh":"双轴象限","en":"Quadrant","family":"scatter","use":"按两项有依据的指标定位","data":"items(label,x,y),x_label,y_label,x_domain,y_domain"},
    {"id":"radar","zh":"雷达图","en":"Radar / Spider","family":"radar","use":"同量规的多维定量比较","data":"axes,series(label,values),scale:[0,共同上限],unit"},
    {"id":"polar","zh":"极坐标图","en":"Polar chart","family":"polar","use":"周期分类上的一项数值","data":"items(label,value),unit"},
    {"id":"loop","zh":"累积循环","en":"Loop","family":"loop","use":"末步返回首步且共同积累状态","data":"nodes,edges,hub:共同汇总状态"},
    {"id":"nested","zh":"嵌套范围","en":"Nested","family":"nested","use":"真实包含与作用范围","data":"nodes(parent:父节点ID 可选)"},
    {"id":"tree","zh":"分类树","en":"Tree","family":"tree","use":"单父分类层级","data":"nodes(parent:父节点ID 可选),edges 可选"},
    {"id":"org_chart","zh":"组织关系","en":"Org chart","family":"tree","use":"真实归属、汇报与升级关系","data":"nodes(parent:父节点ID 可选,detail:职责),edges 可选"},
    {"id":"layer_stack","zh":"分层结构","en":"Layer stack","family":"layers","use":"不同抽象层与职责","data":"items(label,detail)"},
    {"id":"exploded_axonometric","zh":"部件分解","en":"Exploded axonometric","family":"exploded","use":"沿装配轴分开的部件关系（示意）","data":"items(label,detail,width,height,depth:正数),unit"},
    {"id":"axonometric_plan","zh":"空间平面","en":"Axonometric plan","family":"plan","use":"有来源的房间与区域布局（示意）","data":"items(label,x,y,width,height:正数),unit"},
    {"id":"venn","zh":"集合交集","en":"Venn","family":"venn","use":"两个或三个有限集合的包含成员","data":"sets(label,items:字符串数组),universe:字符串数组 可选"},
    {"id":"pyramid_funnel","zh":"层级漏斗","en":"Pyramid / funnel","family":"pyramid","use":"按阶段的真实数量或转化递减","data":"items(label,value:非负),unit"},
    {"id":"bar_chart","zh":"条形图","en":"Bar chart","family":"bar","use":"同单位分类数量比较","data":"items(label,value),unit"},
    {"id":"waterfall","zh":"瀑布图","en":"Waterfall","family":"waterfall","use":"起始总量和有符号贡献到最终总量","data":"start:数值,items(label,value:有符号贡献),unit"},
    {"id":"treemap","zh":"矩形树图","en":"Treemap","family":"treemap","use":"各部分大小与总量关系","data":"items(id,label,value:正数,parent 可选),unit"},
    {"id":"heatmap","zh":"热力矩阵","en":"Heatmap","family":"matrix","use":"二维数据的真实数值","data":"rows,columns,values:数值或null的二维数组,unit"},
    {"id":"line_chart","zh":"折线图","en":"Line chart","family":"line","use":"连续自变量上的变化与缺测","data":"series(label,points:[{x,y:数值或null}]),x_label,y_label,unit"},
    {"id":"gantt","zh":"甘特图","en":"Gantt","family":"gantt","use":"任务起止与时间跨度","data":"items(label,start,end:数值),unit"},
    {"id":"scatter_plot","zh":"散点图","en":"Scatter plot","family":"scatter","use":"两项实际变量的分布（不据此宣称因果）","data":"items(label,x,y),x_label,y_label,unit"},
    {"id":"high_level","zh":"高层数据栈","en":"High-Level","family":"grouped","use":"容器集群中的端到端数据栈","data":"groups,nodes,edges"},
    {"id":"process","zh":"顺序过程","en":"Process","family":"process","use":"步骤、输入输出与交接","data":"nodes,edges"},
    {"id":"medallion","zh":"数据质量分层","en":"Medallion","family":"layers","use":"真实存储质量层与访问政策","data":"items(label,detail)"},
    {"id":"data_flow","zh":"职责数据流","en":"Data flow","family":"swimlane","use":"各角色负责的数据处理步骤","data":"groups,nodes(group:组ID),edges(label:数据)"},
    {"id":"dp_integration","zh":"平台集成","en":"DP integration","family":"grouped","use":"来源、平台核心与消费者拓扑","data":"groups,nodes,edges"},
    {"id":"dp_security_matrix","zh":"访问权限矩阵","en":"DP security matrix","family":"matrix","use":"真实角色与组件的权限","data":"rows,columns,values:权限文字二维数组"},
    {"id":"sankey","zh":"桑基流量","en":"Sankey","family":"sankey","use":"有数量且中间节点守恒的分合流","data":"nodes,edges(value:正数),unit"},
    {"id":"fishbone","zh":"鱼骨分析","en":"Fishbone","family":"fishbone","use":"有依据并按类组织的可能原因","data":"effect:观察结果,groups(id,label),items(label,group:组ID)"},
    {"id":"wardley_map","zh":"价值链演化","en":"Wardley map","family":"wardley","use":"可见性和演化阶段上的依赖","data":"nodes(x:0..1演化,y:0..1可见性),edges,x_label,y_label"},
    {"id":"kanban","zh":"任务看板","en":"Kanban","family":"kanban","use":"真实工作状态、阻塞与 WIP","data":"groups(id,label,limit 可选),nodes(group:组ID,status 可选)"},
    {"id":"user_journey","zh":"用户旅程","en":"User journey","family":"journey","use":"经历阶段、行动与感受","data":"items(label,detail,value:感受数值),unit:共同量规"},
    {"id":"deployment","zh":"部署拓扑","en":"Deployment","family":"grouped","use":"真实运行区域、主机、工件与端口","data":"groups,nodes,edges(label:连接或端口)"},
    {"id":"dependency_graph","zh":"依赖图","en":"Dependency graph","family":"graph","use":"多父依赖或已明确的循环","data":"nodes,edges(label:依赖语义)"},
    {"id":"uml_class","zh":"UML 类图","en":"UML class","family":"entity","use":"类、成员、继承与组合","data":"nodes(detail:属性与方法),edges(kind:inheritance|composition|association,label 可选)"},
    {"id":"story_map","zh":"故事地图","en":"Story map","family":"story","use":"叙事主线按发布批次切分","data":"groups(id,label:主线),rows:发布批次,nodes(group:主线ID,row:批次名称)"},
    {"id":"database_schema","zh":"数据库结构","en":"Database schema","family":"entity","use":"物理表、SQL 类型、约束与外键","data":"nodes(detail:完整字段与约束),edges(label:外键列映射)"},
    {"id":"vector_plot","zh":"二维向量图","en":"2D vector diagram","family":"vectors","use":"有明确二维坐标的向量、平移与线性组合；箭头首尾直接取源数据，两个轴使用同一单位长度","data":"vectors:[{label,from:[x,y],to:[x,y]}],x_label,y_label；最多8个向量；坐标必须来自题设或正文已展示的计算"},
    {"id":"matrix_steps","zh":"矩阵变换步骤","en":"Matrix transformation steps","family":"matrix_steps","use":"逐步呈现来源中的矩阵消元、变换或回代；每步数据及操作文字完整保留","data":"steps:[{label,operation:本步操作可选,values:数字或短纯文本的二维数组}]；最多6步，矩阵行列相同且各不超过6；不写LaTeX代码"}
  ]
}
